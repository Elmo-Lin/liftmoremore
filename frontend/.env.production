# Production build: call the API through the Firebase Hosting rewrite (/api/** -> Cloud Run),
# so the app and API share one origin. Takes precedence over .env.local.
VITE_API_URL=/api
# Google sign-in (same client ID as the backend's GOOGLE_CLIENT_ID). Set before `npm run build`.
VITE_GOOGLE_CLIENT_ID=821276855799-4bfp0ebqppagdf7pq7eqi5462roifqj2.apps.googleusercontent.com
