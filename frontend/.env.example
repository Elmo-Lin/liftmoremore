# Copy to .env.local to connect the frontend to the Lift More More backend.
# Leave unset to run the offline demo (data stored in this browser only).
VITE_API_URL=http://localhost:8080/api
# Google sign-in: OAuth client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Add this site's origin (e.g. http://localhost:5173) to its "Authorized JavaScript origins". Leave unset to hide the button.
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
